# Copia estas variables en la configuración de tu hosting (no las pongas en script.js).
AI_API_KEY=pega_aqui_la_clave_del_proveedor
AI_MODEL=gpt-4o-mini

# Opcional: usa cualquier endpoint compatible con OpenAI Chat Completions.
# Ejemplos: OpenRouter, Groq, DeepSeek o Together.
# AI_API_URL=https://api.openai.com/v1/chat/completions

# Opcional: limita el endpoint a tu dominio.
# ALLOWED_ORIGIN=https://tu-dominio.com

# Opcional: recuperación de fuentes web antes de responder (formato Tavily).
# Si no se configura, la IA externa responde con su conocimiento propio y lo dice cuando el dato pueda estar desactualizado.
# SEARCH_API_KEY=tu_clave_de_busqueda
# SEARCH_API_URL=https://api.tavily.com/search
