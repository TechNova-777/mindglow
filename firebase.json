{
  "hosting": {
    "site": "midglow",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "**/.*",
      ".git/**",
      ".github/**",
      ".vercel/**",
      ".firebase/**",
      "**/node_modules/**",
      "api/**",
      "server.js",
      "package.json",
      "package-lock.json",
      "vercel.json",
      "DEPLOY.md",
      "README.md",
      ".env.example",
      ".env.local.example",
      "assets/3d/*.blend",
