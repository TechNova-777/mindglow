# Desarrollo local: copia este archivo como .env.local y reemplaza la clave.
# Nunca subas .env.local al repositorio.
AI_API_KEY=tu_clave_de_gemini
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.1-flash-lite
AI_MAX_TOKENS=1200

# Opcional: generación de imágenes con la misma clave.
AI_IMAGE_URL=https://generativelanguage.googleapis.com/v1beta/openai/images/generations
AI_IMAGE_MODEL=gemini-2.5-flash-image
